      "item": [
        {
          "id": "c1c53d01-1759-4b14-a77c-2ebc7d278a1d",
          "name": "List CVEs",
          "request": {
            "name": "List CVEs",
            "description": {
              "content": "Returns a list of CVEs affecting Red Hat products. Supports filtering by product, package, CVSS score range, severity, and date range. Results are paginated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cve.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<date>",
                  "description": "Filter CVEs published before this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<date>",
                  "description": "Filter CVEs published after this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "ids_only",
                  "value": "false",
                  "description": "Return only CVE IDs instead of full objects"
                },
                {
                  "disabled": false,
                  "key": "bug",
                  "value": "<string>",
                  "description": "Filter by associated Bugzilla bug ID"
                },
                {
                  "disabled": false,
                  "key": "advisory",
                  "value": "<string>",
                  "description": "Filter by associated security advisory ID"
                },
                {
                  "disabled": false,
                  "key": "severity",
                  "value": "<string>",
                  "description": "Filter by severity level"
                },
                {
                  "disabled": false,
                  "key": "package",
                  "value": "<string>",
                  "description": "Filter by affected package name"
                },
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<string>",
                  "description": "Filter by affected product name"
                },
                {
                  "disabled": false,
                  "key": "cvss_score",
                  "value": "<number>",
                  "description": "Minimum CVSS score"
                },
                {
                  "disabled": false,
                  "key": "cvss3_score",
                  "value": "<number>",
                  "description": "Minimum CVSS v3 score"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "20"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
