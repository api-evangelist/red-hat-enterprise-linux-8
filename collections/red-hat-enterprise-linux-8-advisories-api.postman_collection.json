  "info": {
    "_postman_id": "95221b51-b558-4afe-98f9-51700a078008",
    "name": "Red Hat Security Data Advisories API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Red Hat Security Data API provides public access to Red Hat's security advisory and CVE data. It enables operators to query CVEs affecting RHEL products, retrieve CVSS scores, list security advisories (RHSA), bug fix advisories (RHBA), and enhancement advisories (RHEA), and obtain OVAL XML data for vulnerability scanning integration. No authentication is required for public data access.\n\nContact Support:\n Name: Red Hat Security",
      "type": "text/plain"
    }
  }
