          "name": "List Security Advisories",
          "request": {
            "name": "List Security Advisories",
            "description": {
              "content": "Returns a list of Red Hat security advisories (RHSA), bug fix advisories (RHBA), and enhancement advisories (RHEA). Supports filtering by type, severity, product, and date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "advisory.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<date>",
                  "description": "Filter advisories issued before this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<date>",
                  "description": "Filter advisories issued after this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by advisory type"
                },
                {
                  "disabled": false,
                  "key": "severity",
                  "value": "<string>",
                  "description": "Filter by severity (RHSA only)"
                },
                {
                  "disabled": false,
                  "key": "package",
                  "value": "<string>",
                  "description": "Filter by affected package name"
                },
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<string>",
                  "description": "Filter by affected product"
                },
                {
                  "disabled": false,
                  "key": "cve",
                  "value": "<string>",
                  "description": "Filter by associated CVE ID"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "20"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
